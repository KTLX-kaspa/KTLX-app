# KTLX public config — safe to expose in the browser.
# Admin power = ownership of VITE_ADMIN_ADDRESS wallet (no private keys in the app).

VITE_ADMIN_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_KTLX_TICKER=KTLX
VITE_KTLX_CA=
VITE_ALPHA_MIN_BALANCE=1
VITE_KASPA_API_BASE=https://api.kaspa.org
VITE_KRC20_API_BASE=https://api.kasplex.org/v1
# Optional later: KCC20 descriptor id for kascov fallback
VITE_KTLX_KCC20_DESCRIPTOR=
